# The site's lines for the local platform's caddy.env (CLAUDE.md section 6, "Full stack"): plain
# HTTP on localhost:8080, and the API on the site's own origin too. Public values.
ANTHONYZNG_WEB_SITE_ADDRESS=http://localhost:8080
ANTHONYZNG_WEB_SITE_URL=http://localhost:8080
ANTHONYZNG_WEB_WWW_ADDRESS=http://www.localhost:8080
ANTHONYZNG_WEB_API_ADDRESS=http://api.localhost:8080
ANTHONYZNG_WEB_API_URL=http://api.localhost:8080
ANTHONYZNG_WEB_SITE_EXTRA=api
