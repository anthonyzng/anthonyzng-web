# Root environment for Docker Compose (copy to `.env`; `.env` is git-ignored).
# Used by docker-compose.dev.yml (Phase 4+) and the production stack (Phase 6+).

POSTGRES_USER=anthonyzng
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anthonyzng_web
# Host port the dev database is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
