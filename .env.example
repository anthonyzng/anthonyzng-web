# Root environment for Docker Compose (copy to `.env`; `.env` is git-ignored). Read by
# docker-compose.yml (the full stack), docker-compose.local.yml and docker-compose.dev.yml (the
# database alone). Backend secrets live in backend/.env (see backend/.env.example).

POSTGRES_USER=anthonyzng
# Also part of the backend's DATABASE_URL inside the stack: URL-safe characters only
# (letters, digits, - _ . ~), e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anthonyzng_web
# The full stack's backend connects as this least-privilege role (rows only), which the `migrate`
# service creates and updates on every `up`; POSTGRES_USER above is the schema owner, used by the
# migrations alone. At least 24 URL-safe characters; changing it and running `up -d` rotates it.
# The host-run backend (backend/.env) keeps connecting as the owner.
POSTGRES_APP_USER=anthonyzng_app
POSTGRES_APP_PASSWORD=change-me-change-me-change-me
# Host port the dev database is published on (bound to 127.0.0.1 only; not in production).
POSTGRES_PORT=5432

# --- Full stack (docker-compose.yml). The defaults are production's; the local override sets its own.
# Caddy site addresses: a bare domain gets an automatic Let's Encrypt certificate.
# SITE_ADDRESS=owwsolution.com
# SITE_URL=https://owwsolution.com
# WWW_ADDRESS=www.owwsolution.com
# API_ADDRESS=api.owwsolution.com

# Frontend build arguments (public values, compiled into the bundle). Required for a production
# build; the image build fails when either is empty.
VITE_API_BASE_URL=https://api.owwsolution.com
# Cloudflare Turnstile site key (the real one in production; this is the public always-pass test key).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
