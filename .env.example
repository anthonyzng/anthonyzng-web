# Root environment for Docker Compose (copy to `.env`; `.env` is git-ignored). Read by
# docker-compose.yml (the site on the platform), docker-compose.local.yml and docker-compose.dev.yml
# (the development database alone). Backend secrets live in backend/.env (see backend/.env.example).

# --- The site on the Owwsolution platform (docker-compose.yml) ---------------------------------
# Written by the platform's provision-app, never by hand (it generates the passwords, sends the
# server only SCRAM verifiers and writes these two lines, replacing older ones):
#   scripts/provision-app anthonyzng-web --scheme postgresql+asyncpg --write-env <this .env>
# The owner role runs the migrations; the backend connects as the app role (rows only).
DATABASE_OWNER_URL=postgresql+asyncpg://anthonyzng_web_owner:change-me@platform-postgres:5432/anthonyzng_web
DATABASE_APP_URL=postgresql+asyncpg://anthonyzng_web_app:change-me@platform-postgres:5432/anthonyzng_web
# The app role the migrate service checks (app.db_roles); provision-app names it <database>_app.
DATABASE_APP_USER=anthonyzng_web_app

# --- The development database (docker-compose.dev.yml), for the host-run backend and tests -----
POSTGRES_USER=anthonyzng
# URL-safe characters only (letters, digits, - _ . ~), e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anthonyzng_web
# Host port the dev database is published on (bound to 127.0.0.1 only; not in production).
POSTGRES_PORT=5432

# The frontend's build arguments (VITE_API_BASE_URL, VITE_TURNSTILE_SITE_KEY) are not read from
# here: CI builds the production image with its repository variables, and docker-compose.local.yml
# sets the local values.
