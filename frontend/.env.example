# Frontend build-time configuration. Copy to `frontend/.env` and fill in real values;
# `.env` files are git-ignored, so no personal data is ever committed.

# Public contact address shown in the Contact section (also used as a mailto link).
# Required for a real deployment: it is baked into the bundle at build time, so it must be set
# wherever `npm run build` runs (local .env, Docker build arg, GitHub Actions secret).
# Left empty, the email row is simply omitted and a production build warns about it.
VITE_CONTACT_EMAIL=
