# Frontend build-time configuration. Vite reads `.env` / `.env.local` from this directory (both are
# git-ignored); every value is compiled into the bundle, so only public values belong here.
# Missing values fall back to the defaults below (see src/env.ts).

# Backend origin (no trailing slash). Production: https://api.owwsolution.com
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile site key. The value below is Cloudflare's public "always passes" test key:
# fine for development, never for production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
