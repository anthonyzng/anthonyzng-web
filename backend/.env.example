# Backend configuration (copy to `backend/.env`; `.env` is git-ignored).
# Every value is read by pydantic-settings in app/core/config.py. No defaults for secrets.

# development | test | production. With `production` the app refuses to start on any placeholder
# (`change-me`) secret, an ADMIN_PASSWORD under 12 characters, a Cloudflare test Turnstile secret,
# EMAIL_PROVIDER=console or an empty CORS_ORIGINS.
APP_ENV=development

# SQLAlchemy async URLs. The dev database runs in Docker (docker-compose.dev.yml);
# the *_test database is created by db/init/01-test-database.sh on first start. Inside the full
# stack (docker-compose.yml) DATABASE_URL is replaced with one that points at the `db` service.
DATABASE_URL=postgresql+asyncpg://anthonyzng:change-me@127.0.0.1:5432/anthonyzng_web
TEST_DATABASE_URL=postgresql+asyncpg://anthonyzng:change-me@127.0.0.1:5432/anthonyzng_web_test

# Signs the admin session JWT (httpOnly cookie). At least 32 random bytes, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=change-me-change-me-change-me-change-me

# HMAC key for the hashed visitor IP stored with contact messages (raw IPs are never stored,
# emailed or logged). At least 32 characters, different from JWT_SECRET. Changing it makes
# earlier hashes impossible to match against new ones.
IP_HASH_SECRET=change-me-change-me-change-me-change-me

# Encrypts the admin's two-factor (TOTP) secret in the database. At least 32 characters,
# different from the two above, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Changing it makes a stored secret unreadable: turn two-factor sign-in off with
# `python -m app.admin_totp reset` and set it up again.
TOTP_ENCRYPTION_KEY=change-me-change-me-change-me-change-me

# The single admin account, created/updated on startup from these values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Where contact-form messages are delivered, and the sender address they arrive from.
CONTACT_TO_EMAIL=you@example.com
EMAIL_FROM=noreply@owwsolution.com

# Comma-separated browser origins allowed to call the API (exact origins, no `*`).
CORS_ORIGINS=http://localhost:5173

# Cloudflare Turnstile server-side secret. The value below is Cloudflare's public
# "always passes" test secret: fine for development, never for production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# console (log the email instead of sending it) | resend (needs RESEND_API_KEY)
EMAIL_PROVIDER=console
RESEND_API_KEY=

# true only behind the reverse proxy (Caddy): the client IP is then taken from the rightmost
# X-Forwarded-For entry instead of the socket peer. docker-compose.yml sets it to true for the stack.
TRUSTED_PROXY=false
